# ── 빈틈(BinTeum) 환경변수 예시 ─────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 ZIP/GitHub에 올리지 마세요.
# (run.sh 는 .env 가 있으면 자동으로 읽습니다.)

# 1) 제주데이터허브 Open API 인증키 (선택)
#    - 발급: jejudatahub.net 로그인 → 마이페이지 → Open API 인증키 신청
#    - 없으면 ZIP에 동봉된 스냅샷으로 동작합니다(정상 동작, 화면에 모드 표시).
JEJU_DATA_HUB_KEY=

# 2) LLM (선택) — 없으면 결정론적 템플릿 문장으로 동작합니다.
#    openai | anthropic | local | none
#    local = OpenAI 호환 로컬 서버(Ollama 등). 키 없이 동작.
# BINTEUM_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
BINTEUM_LLM_PROVIDER=none
BINTEUM_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 3) 선택 설정
# JEJU_HUB_TIMEOUT=20
# JEJU_HUB_RETRIES=2
# BINTEUM_OUT_DIR=./out
